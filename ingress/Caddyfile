# vps1777 — Caddyfile
#
# Reverse proxy → gateway:8080. Cert auto via ACME.
# Ne esistono DUE copie, e questo commento è lo stesso in entrambe:
#   · ingress/Caddyfile        — l'ingresso normale (sfida HTTP-01, porta 80);
#   · ingress/Caddyfile.dns01  — la stessa configurazione più la riga `acme_dns`
#     nelle opzioni globali (sfida DNS-01 via Cloudflare). La monta la feature
#     `caddy-dns01` (VPS1777_FEATURES), su un'immagine col plugin: vedi
#     docs/INGRESS.md §DNS-01. Per DNS-01 non si scommenta niente nel primo file.
# ⚠️ Chi cambia una copia cambia l'altra: tools/tests/test_caddy_dns01.py pretende
#   che differiscano SOLO per il blocco `acme_dns`.

{
	# Global options
	email {env.CADDY_EMAIL}
}

{env.CADDY_DOMAIN} {
	encode zstd gzip

	# Health check Caddy stesso
	@health path /health
	respond @health 200

	# Tetto ASSOLUTO sul body — difesa in profondità sopra quello del gateway
	# (voce 92118d4e). Il taglio FINE, per path, resta nel gateway
	# (`asgi_security.BodyCapASGI`: 32 MB di default, MAX_UPLOAD_BYTES sui due path
	# di upload). Qui NON si replica quella lista: due copie della stessa lista in
	# due linguaggi divergono, e la copia sbagliata sarebbe quella che decide per
	# prima. Caddy taglia solo l'ASSURDO — ciò che nessun path può mai accettare.
	#
	# 📏 PERCHÉ 5GB E NON 4GB: il massimo legittimo del sistema è MAX_UPLOAD_BYTES
	#   = 4 GB, ma un upload multipart di 4 GB ha un BODY leggermente più grande
	#   (boundary + header della parte). Con `max_size 4GB` Caddy taglierebbe un
	#   upload che il gateway accetterebbe: diventerebbe LUI il decisore, e la
	#   logica per-path del gateway non verrebbe mai raggiunta. Il margine serve a
	#   restare la seconda linea, non la prima.
	#
	# 🔬 MISURATO il 09/08 su caddy:2.8-alpine (lo stesso digest di
	#   compose.ingress.caddy.yaml), perché la direttiva ha un comportamento che la
	#   documentazione non rende ovvio — e la prima prova mi aveva dato un falso OK:
	#     request_body max_size 1KB + `respond`        → body da 5000 byte: HTTP 200 (!)
	#     request_body max_size 1KB + `reverse_proxy`  → body da 5000 byte: HTTP 413
	#   Il tetto scatta quando qualcosa LEGGE il body. Con `respond` nessuno lo
	#   legge, quindi non taglia: provarlo con un `respond` avrebbe certificato una
	#   protezione inesistente. Qui siamo nel ramo `reverse_proxy`, dove funziona.
	request_body {
		max_size 5GB
	}

	# Forward al gateway (compresso, streaming OK per MCP)
	reverse_proxy gateway:8080 {
		flush_interval -1   # streaming/SSE compatibile
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}

	# log — con ogni segmento lungo dell'URI REDATTO (H78 01/10, H79 04/10/2026). Il
	# gateway_secret vive nel path del proxy MCP (/<SECRET>/<servizio>/mcp) e l'access-log
	# JSON di Caddy scrive `request.uri` così com'è. Il segreto non sta solo all'inizio: i
	# client OAuth lo portano anche nel `resource` dell'autorizzazione (in query, codificato
	# %2F) e nei metadati chiesti col path in coda (/.well-known/…/<SECRET>/…). Il filtro
	# sostituisce con *** ogni segmento di ≥16 caratteri dopo / o %2F, senza consumare il
	# separatore che segue (così due segmenti lunghi di fila li prende entrambi). Misurato
	# con caddy:2.11. Costo: anche i nomi lunghi (oauth-authorization-server) diventano ***
	# qui; il log del gateway li tiene leggibili, perché redige solo il valore del segreto.
	# P15 (10/10/2026): anche il gettone dei link firmati (`/scarica/<nome>?t=<scade>.<firma>`),
	# che vale 30 minuti: la seconda alternativa lo redige senza toccare gli altri parametri.
	log {
		output stdout
		format filter {
			wrap json
			request>uri regexp "(/|%2[Ff])[A-Za-z0-9_-]{16,}|([?&]t=)[0-9]+\.[0-9a-f]+" "${1}${2}***"
		}
	}
}
